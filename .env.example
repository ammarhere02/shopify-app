# MySQL connection used by Prisma (matches docker-compose.yml)
DATABASE_URL="mysql://app:app@localhost:3307/enrichment_hub"
# Separate local DB for integration tests (never point this at the app database)
TEST_DATABASE_URL="mysql://app:app@localhost:3307/enrichment_hub_test"
# AI description generator (server-side only; never expose these to the browser)
OPENROUTER_API_KEY="sk-or-v1-replace-me"
# Comma-separated allowlist of vision models that support structured outputs. The first is the default.
OPENROUTER_MODELS="replace-with-vendor/model-id"
# "deny" (default) routes only to providers that do not retain or train on prompts.
# Free endpoints usually require "allow"; use that for development data only.
# OPENROUTER_DATA_COLLECTION=deny
# Optional, defaults shown
# OPENROUTER_TIMEOUT_MS=60000
# OPENROUTER_MAX_RETRIES=2
# AI_MAX_OUTPUT_TOKENS=1500
# AI_MAX_IMAGES=4
# AI_DAILY_LIMIT_PER_SHOP=50
# AI_MAX_CONCURRENT_PER_SHOP=1
# AI_WORKER=off   # disables the in-process worker that runs queued (batch) generations
# SHOPIFY_API_KEY / SHOPIFY_API_SECRET / SHOPIFY_APP_URL / SCOPES are injected by `shopify app dev`.
