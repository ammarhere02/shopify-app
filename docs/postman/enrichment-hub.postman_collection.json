{
  "info": {
    "name": "Enrichment Hub API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set baseUrl (https://<app-url>/api/v1), apiKey (eh_live_\u2026), productId (numeric Shopify id). jobId, versionId and publicationId are filled from responses."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://enrichment-hub.onrender.com/api/v1"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "versionId",
      "value": ""
    },
    {
      "key": "publicationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Products and enrichment",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?hasBadge=true&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products?hasBadge=true&limit=10"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Put enrichment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/enrichment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "enrichment"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"badgeText\": \"New\",\n  \"badgeColor\": \"#1A7F37\",\n  \"active\": true,\n  \"internalNote\": \"Autumn launch\"\n}"
            }
          }
        },
        {
          "name": "Delete enrichment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/enrichment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "enrichment"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Sync",
      "item": [
        {
          "name": "Start sync",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/syncs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "syncs"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"FULL\"\n}"
            }
          }
        },
        {
          "name": "Get sync run",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/syncs/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "syncs",
                "1"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "AI descriptions",
      "item": [
        {
          "name": "Images usable for generation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/images",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "images"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Start generation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/description-generations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "description-generations"
              ]
            },
            "description": "Idempotency-Key is a fresh GUID per intended generation; reuse it to retry safely.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mediaIds\": [\n    \"gid://shopify/MediaImage/REPLACE\"\n  ],\n  \"merchantContext\": \"Merino wool, for winter commuters\"\n}"
            }
          }
        },
        {
          "name": "List generations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/description-generations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "description-generations"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get generation (poll)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/description-generations/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "description-generations",
                "{{jobId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Regenerate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/description-generations/{{jobId}}/regenerate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "description-generations",
                "{{jobId}}",
                "regenerate"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Batch generation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/description-generations/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "description-generations",
                "batch"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productIds\": [\n    \"{{productId}}\"\n  ],\n  \"merchantContext\": \"Winter collection\"\n}"
            },
            "description": "Queues one job per product; the worker runs them. Poll each generationId."
          }
        },
        {
          "name": "Apply approved draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/description-generations/{{jobId}}/apply",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "description-generations",
                "{{jobId}}",
                "apply"
              ]
            },
            "description": "Approve the draft in the admin UI first."
          }
        },
        {
          "name": "List versions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/description-versions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "description-versions"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Restore version",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/description-versions/{{versionId}}/restore",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "description-versions",
                "{{versionId}}",
                "restore"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"which\": \"written\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Publishing",
      "item": [
        {
          "name": "Sales channels and history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/publish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "publish"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Publish to channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/publish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "publish"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publicationId\": \"{{publicationId}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "No key \u2192 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "Bad body \u2192 422",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/enrichment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "enrichment"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"badgeText\": \"\",\n  \"badgeColor\": \"green\"\n}"
            }
          }
        }
      ]
    }
  ]
}